# Copy this file to ".env" and fill in what you have. Everything here is optional:
# API keys can also be pasted into the app's Settings screen instead.

# Needed as soon as the app is reachable from anywhere but your own computer.
APP_PASSWORD=

# Claude    https://console.anthropic.com
ANTHROPIC_API_KEY=
# GPT       https://platform.openai.com
OPENAI_API_KEY=
# Gemini    https://aistudio.google.com
GEMINI_API_KEY=
# Grok      https://console.x.ai
XAI_API_KEY=

# Only for hosts with no permanent disk: a Postgres address to store everything in.
DATABASE_URL=
