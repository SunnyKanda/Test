{
  "name": "nikke-bol-app",
  "version": "1.0.0",
  "private": true,
  "description": "Nikke Bol (\u0a28\u0a3f\u0a71\u0a15\u0a47 \u0a2c\u0a4b\u0a32) for iOS and Android, wrapping the web app in ../nikke-bol with Capacitor.",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#3a0d2e' --splashBackgroundColor '#3a0d2e'",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android",
    "screenshots": "node scripts/screenshots.cjs",
    "icons": "node scripts/render-assets.cjs && npm run assets"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/share": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9"
  }
}
